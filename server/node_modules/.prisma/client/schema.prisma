generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  KIOSK_DEVICE
  TRIAGE_NURSE
  JUNIOR_DOCTOR
  SENIOR_CONSULTANT
  HOSPITAL_ADMIN
  PATIENT
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}

enum EncounterStatus {
  WAITING
  TRIAGED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  REFERRED_UP
}

enum PriorityLevel {
  ROUTINE
  URGENT
  EMERGENCY
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String?
  name         String
  role         Role         @default(PATIENT)
  authProvider AuthProvider @default(LOCAL)
  isVerified   Boolean      @default(false)
  createdAt    DateTime     @default(now())

  patientProfiles PatientProfile[]
  encounters      Encounter[]
  auditLogs       AuditLog[]
}

model PatientProfile {
  id               String   @id @default(uuid())
  userId           String
  abhaNumber       String?  @unique
  maskedIdentifier String?
  fullName         String
  dateOfBirth      DateTime
  gender           String
  bloodGroup       String?
  contactNumber    String?
  emergencyContact String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  encounters Encounter[]
}

model Encounter {
  id            String          @id @default(uuid())
  patientId     String
  doctorId      String?
  departmentId  String?
  status        EncounterStatus @default(WAITING)
  queueToken    String?
  priorityLevel PriorityLevel   @default(ROUTINE)
  fhirBundle    Json?
  createdAt     DateTime        @default(now())

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User?          @relation(fields: [doctorId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  resourceId String?
  ipAddress  String?
  timestamp  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
